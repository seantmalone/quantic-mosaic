{
  "name": "lookup_employee_profile",
  "description": "Look up one employee's synthetic HR profile: role, office, work arrangement, tenure at the data snapshot, manager and skip level. An unknown id returns status='not_found'.",
  "input_schema": {
    "properties": {
      "employee_id": {
        "description": "An employee id, e.g. E1042.",
        "pattern": "^E1[0-9]{3}$",
        "title": "Employee Id",
        "type": "string"
      }
    },
    "required": [
      "employee_id"
    ],
    "title": "lookup_employee_profileArguments",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Office": {
        "properties": {
          "office_id": {
            "title": "Office Id",
            "type": "string"
          },
          "city": {
            "title": "City",
            "type": "string"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "entity": {
            "title": "Entity",
            "type": "string"
          }
        },
        "required": [
          "office_id",
          "city",
          "country",
          "timezone",
          "entity"
        ],
        "title": "Office",
        "type": "object"
      },
      "Person": {
        "properties": {
          "employee_id": {
            "title": "Employee Id",
            "type": "string"
          },
          "preferred_name": {
            "title": "Preferred Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "employee_id",
          "preferred_name",
          "title"
        ],
        "title": "Person",
        "type": "object"
      }
    },
    "description": "The §8.4 tool-5 record, or `{status: not_found}` — every field is optional for that reason.",
    "properties": {
      "employee_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Employee Id"
      },
      "as_of": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
