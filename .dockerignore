# Keep the build context to what §14.2's Dockerfile actually COPYs.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Secrets and local state never enter the build context
.env
.env.*
.cache/
data/runtime/

# The index is rebuilt inside the image; only the committed manifest goes in.
data/index/*
!data/index/chunks.manifest.jsonl

# Dev tooling, docs and the test suite stay out — except the stub scripts, which the
# default LLM_STUB_SCRIPT must resolve to inside the container for the memory gate.
requirements-dev.txt
docs/
scripts/
.superpowers/
tests/
!tests/fixtures/llm_scripts/
