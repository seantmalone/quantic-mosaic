# Mosaic HR Copilot — environment template (spec §12.3).
# Copy to `.env` (git-ignored) and fill in what you need. Boot never fails on a missing
# credential: the app starts, /health reports `degraded`, and the surface that needs the key
# says so with the variable name and its signup URL.
#
# Every key below is a field of `src/hrmosaic/settings.py`, and every field is a key below —
# `tests/contract/test_env_example_covers_settings.py` asserts both directions.
# Keys shown commented out have a computed default; uncomment only to override it.

# --- application ---------------------------------------------------------------------------
PORT=8000                                  # OPTIONAL — Render injects this
APP_ENV=local                              # OPTIONAL — local | docker | render
# GIT_SHA=                                 # OPTIONAL — computed: GIT_SHA, then RENDER_GIT_COMMIT, then "dev"

# --- agent provider ------------------------------------------------------------------------
LLM_PROVIDER=anthropic                     # OPTIONAL — anthropic | openai_compat | stub
ANTHROPIC_API_KEY=                         # REQUIRED for real answers (not for boot) — https://console.anthropic.com/settings/keys
LLM_MODEL=claude-haiku-4-5                 # OPTIONAL — pinned; any other Anthropic model needs explicit approval
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # OPTIONAL — read only when LLM_PROVIDER=openai_compat
LLM_API_KEY=                               # OPTIONAL — the free openai_compat path — https://aistudio.google.com/apikey
LLM_DAILY_CALL_CAP=1500                    # OPTIONAL — provider calls per UTC day, counted from llm_call spans
LLM_TEMPERATURE=0                          # OPTIONAL — determinism
LLM_STUB_SCRIPT=tests/fixtures/llm_scripts/demo_task_1.json   # OPTIONAL — which script StubAdapter replays
LLM_RPM=10                                 # OPTIONAL — token-bucket refill rate (LLM_RPM/60 per second)
# LLM_BURST=                               # OPTIONAL — computed: token-bucket capacity, defaults to LLM_RPM

# --- failover provider ---------------------------------------------------------------------
LLM_FALLBACK_PROVIDER=openai_compat        # OPTIONAL — failover on repeated 429 / 5xx / timeouts
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # OPTIONAL — failover endpoint
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite   # OPTIONAL — failover model (free tier)
LLM_FALLBACK_API_KEY=                      # OPTIONAL — failover key — https://aistudio.google.com/apikey

# --- judge provider ------------------------------------------------------------------------
JUDGE_PROVIDER=openai_compat               # OPTIONAL — a different vendor and family from the agent, by construction
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # OPTIONAL — judge endpoint
JUDGE_MODEL=gemini-3.5-flash-lite          # OPTIONAL — judge model (free tier)
JUDGE_API_KEY=                             # OPTIONAL — a key on a SECOND Google Cloud project; falls back to LLM_API_KEY — https://aistudio.google.com/apikey

# --- embeddings ------------------------------------------------------------------------------
EMBED_PROVIDER=fastembed                   # OPTIONAL — fastembed | fake (unit tests and the offline ingest smoke only)
EMBED_MODEL=BAAI/bge-small-en-v1.5         # OPTIONAL — must match index_meta
EMBED_DIM=384                              # OPTIONAL — must match index_meta
EMBED_WARMUP=1                             # OPTIONAL — 0 skips the startup ONNX warm-up
FASTEMBED_CACHE_PATH=./.cache/fastembed    # OPTIONAL — model cache; the Docker image overrides it to /app/models

# --- retrieval ---------------------------------------------------------------------------------
INDEX_PATH=data/index/hr_index.sqlite      # OPTIONAL — read-only index
RETRIEVAL_K=5                              # OPTIONAL — process default only; options.k wins per request
RETRIEVAL_STRATEGY=hybrid_rrf              # OPTIONAL — hybrid_rrf | dense_only; process default only
MIN_EVIDENCE_SCORE=0.60                    # OPTIONAL — G1 threshold (calibrated at P10)
MIN_SUPPORT_SCORE=0.45                     # OPTIONAL — G1 second-chunk floor (calibrated at P10)

# --- chunking ------------------------------------------------------------------------------------
CHUNK_MAX_CHARS=1400                       # OPTIONAL — leaves longer than this are windowed
CHUNK_WINDOW_CHARS=1100                    # OPTIONAL — window size
CHUNK_OVERLAP_CHARS=150                    # OPTIONAL — window overlap on sentence boundaries
CHUNK_MIN_CHARS=120                        # OPTIONAL — minimum chunk length

# --- agent loop budgets ------------------------------------------------------------------------
AGENT_MAX_STEPS=6                          # OPTIONAL — per-turn step budget
AGENT_MAX_TOOL_CALLS=8                     # OPTIONAL — per-turn tool-call budget
AGENT_WALL_CLOCK_S=90                      # OPTIONAL — per-turn wall-clock budget in seconds

# --- MCP -----------------------------------------------------------------------------------------
MCP_TRANSPORT=http                         # OPTIONAL — http | stdio
# MCP_SERVER_URL=                          # OPTIONAL — computed from PORT as http://127.0.0.1:PORT/mcp-server/mcp
MCP_TOOLS_DISABLED=                        # OPTIONAL — comma-separated tool names; process default only

# --- persistence -----------------------------------------------------------------------------------
TURSO_DATABASE_URL=                        # REQUIRED in production (durable audit log) — https://turso.tech
TURSO_AUTH_TOKEN=                          # REQUIRED in production (durable audit log) — https://turso.tech
PERSIST_BACKEND=auto                       # OPTIONAL — auto | sqlite | turso
TRACE_DB_PATH=data/runtime/traces.sqlite   # OPTIONAL — local SQLite trace store
TRACE_RETENTION_SESSIONS=300               # OPTIONAL — retention cap

# --- access -------------------------------------------------------------------------------------------
APP_ACCESS_TOKEN=                          # REQUIRED on the graded deployment — generated by scripts/provision_render.py
ACCESS_RATE_LIMIT_PER_MIN=30               # OPTIONAL — per-IP limit on POST /chat and the MCP mount

# --- evaluation ------------------------------------------------------------------------------------------
EVAL_TARGET_BASE_URL=http://127.0.0.1:8000 # OPTIONAL — where `make eval` posts
EVAL_COLD_IDLE_S=1000                      # OPTIONAL — idle wait before each cold probe
EVAL_SMOKE_MAX_ITEMS=6                     # OPTIONAL — cap on a dashboard-launched eval

# --- misc ---------------------------------------------------------------------------------------------------
LLM_CACHE_TTL_S=0                          # OPTIONAL — 0 disables the optional llm_cache entirely
READY_WARMUP_TIMEOUT_S=30                  # OPTIONAL — budget for the startup warm-up that turns /ready green
